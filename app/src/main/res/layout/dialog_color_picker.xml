<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_coui_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvPickerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/dialog_color_title"
        android:textColor="?attr/couiTextPrimary"
        android:textSize="18sp" />

    <io.github.nicochanyo.c17fpoverlap.CouiHsvColorPickerView
        android:id="@+id/hsvColorPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPickerCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_coui_btn_secondary"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/btn_cancel"
            android:textAllCaps="false"
            android:textColor="?attr/couiTextPrimary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnPickerApply"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_coui_btn_primary"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:tag="accent_btn"
            android:text="@string/btn_apply_color"
            android:textAllCaps="false"
            android:textColor="?attr/couiOnAccent"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
